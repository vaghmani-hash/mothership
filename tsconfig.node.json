{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/main/**/*", "src/host/**/*", "src/preload/**/*", "src/shared/**/*", "test/**/*.ts", "electron.vite.config.ts", "vitest.config.ts"]
}
